# Supabase — copy from your Supabase project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# WARNING: SUPABASE_SERVICE_ROLE_KEY bypasses RLS and must NEVER be exposed to the client.
# Only import in server-side code (Server Components, Route Handlers, API routes).
# Do NOT use in Client Components or any file that runs in the browser.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
